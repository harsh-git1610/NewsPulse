# PostgreSQL connection string from Neon (use the pooled connection URL with sslmode=require)
DATABASE_URL=postgresql://<user>:<password>@<neon-hostname>/neondb?sslmode=require

# Server port (optional, default: 3000)
PORT=3000

# Allowed CORS origin in production (optional, default: *)
FRONTEND_ORIGIN=http://localhost:3000

# Python executable (optional: 'python' on Windows, 'python3' on Linux)
PYTHON_BIN=python
